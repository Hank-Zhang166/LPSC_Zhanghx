<mxfile host="app.diagrams.net"><diagram name="一次证据如何获得行动资格" id="release"><mxGraphModel adaptiveColors="auto" pageWidth="1200" pageHeight="445"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e0" parent="1" edge="1" source="n0" target="n1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" parent="1" edge="1" source="n1" target="n2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" parent="1" edge="1" source="n2" target="n3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" parent="1" edge="1" source="n4" target="n5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" parent="1" edge="1" source="n5" target="n6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" parent="1" edge="1" source="n6" target="n7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;初相 / 成分报告&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;粉体批号及不确定性&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#F8EDDB;fontColor=#855717;strokeColor=#F8EDDB;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="12" y="55" width="260" height="92" as="geometry" /></mxCell><mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;审核并发布&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;记录 qc_released_at&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#EDF0F1;fontColor=#405966;strokeColor=#EDF0F1;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="315" y="55" width="255" height="92" as="geometry" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="&lt;b&gt;结构候选集&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;改占位族与抽样权重&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#E4EDF6;fontColor=#26597E;strokeColor=#E4EDF6;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="625" y="55" width="256" height="92" as="geometry" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="&lt;b&gt;补作业或保留&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;只动尚可调整的任务&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#D9EFE9;fontColor=#076E62;strokeColor=#D9EFE9;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="931" y="55" width="258" height="92" as="geometry" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="&lt;b&gt;独立 DFT 偏差&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;跨构型族复现问题&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#F8EDDB;fontColor=#855717;strokeColor=#F8EDDB;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="12" y="258" width="260" height="92" as="geometry" /></mxCell><mxCell id="n5" parent="1" vertex="1" value="&lt;b&gt;有价值的标签批&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;分层选帧、剔除近邻&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#EDF0F1;fontColor=#405966;strokeColor=#EDF0F1;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="315" y="258" width="255" height="92" as="geometry" /></mxCell><mxCell id="n6" parent="1" vertex="1" value="&lt;b&gt;训练与独立验收&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;检查目标改善与源域遗忘&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#E4EDF6;fontColor=#26597E;strokeColor=#E4EDF6;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="625" y="258" width="256" height="92" as="geometry" /></mxCell><mxCell id="n7" parent="1" vertex="1" value="&lt;b&gt;新势可用&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;重算赶得上冻结才行动&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#D9EFE9;fontColor=#076E62;strokeColor=#D9EFE9;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="931" y="258" width="258" height="92" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>