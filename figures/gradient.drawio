<mxfile host="app.diagrams.net"><diagram name="谁提供标签，谁接收梯度" id="gradient"><mxGraphModel adaptiveColors="auto" pageWidth="1200" pageHeight="445"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e0" parent="1" edge="1" source="n0" target="n2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" parent="1" edge="1" source="n1" target="n2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" parent="1" edge="1" source="n2" target="n3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" parent="1" edge="1" source="n3" target="n4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" parent="1" edge="1" source="n4" target="n5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" parent="1" edge="1" source="n5" target="n6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" parent="1" edge="1" source="n6" target="n3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" parent="1" edge="1" source="n6" target="n7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;源域保留批次&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;参考口径一致 / 抑制遗忘&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#EDF0F1;fontColor=#405966;strokeColor=#EDF0F1;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="8" y="48" width="238" height="88" as="geometry" /></mxCell><mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;目标域 DFT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;E、F，可选 virial&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#F8EDDB;fontColor=#855717;strokeColor=#F8EDDB;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="8" y="210" width="238" height="88" as="geometry" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="&lt;b&gt;按系统组批&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;元素映射、原子数、掩码&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#EDF0F1;fontColor=#405966;strokeColor=#EDF0F1;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="300" y="127" width="242" height="96" as="geometry" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="&lt;b&gt;描述符 θ 和能量头 φ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;前向得到 E，求导得到 F&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#E4EDF6;fontColor=#26597E;strokeColor=#E4EDF6;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="590" y="127" width="252" height="96" as="geometry" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="&lt;b&gt;损失与权重&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;wE LE + wF LF + wΞ LΞ&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#F8EDDB;fontColor=#855717;strokeColor=#F8EDDB;fontFamily=