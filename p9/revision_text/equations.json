  "collective": "\\sigma_{\\mathrm{coll}}=\\frac{1}{6Vk_{\\mathrm{B}}T}\\lim_{\\tau\\to\\infty}\\frac{\\mathrm{d}}{\\mathrm{d}\\tau}\\left\\langle\\left|\\sum_j q_j\\Delta\\boldsymbol{r}_j(\\tau)\\right|^2\\right\\rangle",
