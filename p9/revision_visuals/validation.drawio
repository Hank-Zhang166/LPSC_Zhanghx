lAlign=middle;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontColor=#9D5425;fontFamily=Microsoft YaHei;fontSize=16.7;fontStyle=0;" value="B，新批 2"><mxGeometry x="847.918" y="142.3" width="100.164" height="23.4" as="geometry" /></mxCell><mxCell id="48" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontColor=#526774;fontFamily=Microsoft YaHei;fontSize=17.2;fontStyle=0;" value="每个圆点代表一个独立粉体批次；同粉体分样和 EIS 技术重复另记父键。"><mxGeometry x="12" y="214.91" width="644.338" height="24.18" as="geometry" /></mxCell><mxCell id="49" parent="1" vertex="1" style="rounded=0;html=1;fillColor=#F0F4F3;strokeColor=none;strokeWidth=1;" value=""><mxGeometry x="12" y="267" width="976" height="61" as="geometry" /></mxCell><mxCell id="50" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontColor=#172E3D;fontFamily=Microsoft YaHei;fontSize=17.8;fontStyle=1;" value="单名额情景仿真只研究一次预约决策。"><mxGeometry x="23" y="273.52" width="349.28000000000003" height="24.96" as="geometry" /></mxCell><mxCell id="51" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontColor=#526774;fontFamily=Microsoft YaHei;fontSize=16.7;fontStyle=0;" value="两组成复验是湿实验计划，需在现场确认资源和最小可行动差后实施。"><mxGeometry x="23" y="298.3" width="588.6" height="23.4" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>