"n6" target="n2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" parent="1" edge="1" source="n3" target="n7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n0" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;结构假说&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;整数计量、相与局域约&lt;br&gt;束&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#EDF0F1;fontColor=#405966;strokeColor=#EDF0F1;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="16" y="54" width="258" height="99" as="geometry" /></mxCell><mxCell id="n1" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;热历史与相对能&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;整胞 ΔF、有效冻结温&lt;br&gt;度&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#E4EDF6;fontColor=#26597E;strokeColor=#E4EDF6;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="319" y="54" width="258" height="99" as="geometry" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;归一化先验&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;简并度、提议概率、支&lt;br&gt;持集&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#E4EDF6;fontColor=#26597E;strokeColor=#E4EDF6;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="622" y="54" width="258" height="99" as="geometry" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;重加权族分布&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;BME 点解与权重区间&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#D9EFE9;fontColor=#076E62;strokeColor=#D9