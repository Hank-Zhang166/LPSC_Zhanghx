<mxfile host="app.diagrams.net"><diagram name="规划与评价的两层事件过程" id="two_simulations"><mxGraphModel adaptiveColors="auto" pageWidth="1200" pageHeight="378"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e0" parent="1" edge="1" source="n0" target="n1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" parent="1" edge="1" source="n1" target="n2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" parent="1" edge="1" source="n2" target="n3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" parent="1" edge="1" source="n4" target="n5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" parent="1" edge="1" source="n5" target="n6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" parent="1" edge="1" source="n6" target="n7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" parent="1" edge="1" source="n7" target="n3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n0" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;当前信息状态&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;仅已发布信念及可见队&lt;br&gt;列&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#EDF0F1;fontColor=#405966;strokeColor=#EDF0F1;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="16" y="54" width="258" height="99" as="geometry" /></mxCell><mxCell id="n1" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;条件未来分支&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;待发布及备选动作&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#E4EDF6;fontColor=#26597E;strokeColor=#E4EDF6;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="319" y="54" width="258" height="99" as="geometry" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;时间与发布预测&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;队列、审核、动作可用&lt;br&gt;性&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#E4EDF6;fontColor=#26597E;strokeColor=#E4EDF6;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="622" y="54" width="258" height="99" as="geometry" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;执行可行首步&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;提交、并行、等待或停&lt;br&gt;止&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#D9EFE9;fontColor=#076E62;strokeColor=#D9EFE9;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="925" y="54" width="258" height="99" as="geometry" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;共同潜在情景&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;稳定键随机数、外层真&lt;br&gt;值&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#F8EDDB;fontColor=#855717;strokeColor=#F8EDDB;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="16" y="255" width="258" height="99" as="geometry" /></mxCell><mxCell id="n5" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;完整事件重放&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;五类观测各自发布&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#E4EDF6;fontColor=#26597E;strokeColor=#E4EDF6;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="319" y="255" width="258" height="99" as="geometry" /></mxCell><mxCell id="n6" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;候选与费用终点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;确认、风险、资源&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#D9EFE9;fontColor=#076E62;strokeColor=#D9EFE9;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="622" y="255" width="258" height="99" as="geometry" /></mxCell><mxCell id="n7" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;配对政策比较&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;同种子差值与重复区间&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#D9EFE9;fontColor=#076E62;strokeColor=#D9EFE9;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="925" y="255" width="258" height="99" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>