<mxfile host="app.diagrams.net"><diagram name="实验与算力共享的行动网络" id="network"><mxGraphModel adaptiveColors="auto" pageWidth="1200" pageHeight="378"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e0" parent="1" edge="1" source="n0" target="n1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" parent="1" edge="1" source="n1" target="n2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" parent="1" edge="1" source="n2" target="n3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" parent="1" edge="1" source="n4" target="n5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" parent="1" edge="1" source="n5" target="n6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" parent="1" edge="1" source="n6" target="n7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" parent="1" edge="1" source="n5" target="n1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" parent="1" edge="1" source="n2" target="n6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#586E74;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n0" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;制备与分样&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;炉台、人力、样品消耗&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#F8EDDB;fontColor=#855717;strokeColor=#F8EDDB;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="16" y="54" width="258" height="99" as="geometry" /></mxCell><mxCell id="n1" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;物相与成分&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;XRD 槽 · 审核发布&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#F8EDDB;fontColor=#855717;strokeColor=#F8EDDB;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="319" y="54" width="258" height="99" as="geometry" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;主条件 EIS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;压片、EIS 槽、装夹&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#F8EDDB;fontColor=#855717;strokeColor=#F8EDDB;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="622" y="54" width="258" height="99" as="geometry" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;独立新批确认&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;重复制备与最终判据&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#D9EFE9;fontColor=#076E62;strokeColor=#D9EFE9;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="925" y="54" width="258" height="99" as="geometry" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="&lt;b style=&quot;font-size:26px&quot;&gt;结构支持与外送&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot;&gt;构型